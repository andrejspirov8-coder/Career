.DS_Store
__pycache__/
*.pyc
.env
.env.*

# Job-search local / sensitive data (see job-search/.gitignore)
job-search/output/
job-search/tmp/
job-search/inbox/jobs/*.job.txt
job-search/packs/*/
!job-search/packs/README.md
job-search/pipeline/applications.csv
job-search/pipeline/recruiters.csv
job-search/pipeline/recruiter_outreach_log.csv
job-search/linkedin/.browser-profile/
job-search/linkedin/run_logs/
job-search/pipeline/run_logs/
job-search/*.pdf
job-search/.job_processing_log.json
job-search/batch_results.json
job-search/summary_report_*.md
job-search/summary_report_*.json

# Raycast extension build artifacts
raycast-job-search-hub/node_modules/
raycast-job-search-hub/dist/

job-search/linkedin/config.yaml

# Private per-user config (settings.yaml holds runtime policy; opportunities.yaml is private prefs)
job-search/config/settings.yaml
job-search/config/opportunities.yaml

# Agent scratch artifacts (never commit: the .patch contains a leaked token value)
job-search-baseline-*.patch
job-search-baseline-*.status
job-search/config/*.bak
job-search/config/*.new

# Node modules at workspace root / job-search root (not tracked)
node_modules/
job-search/node_modules/

# Browser automation scratch
.playwright-cli/

# Defense-in-depth: job-search runtime artifacts (secondary coverage)
job-search/state/
job-search/runtime/
job-search/reports/
job-search/*.sqlite
job-search/*.db

# Local development agent workspace
.superpowers/
