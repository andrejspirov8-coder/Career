# Copy to .env and fill in values
EXA_API_KEY=

# LinkedIn dispatch mode (manual | cli_gated)
# LINKEDIN_SEND_MODE=manual

# Override the project root (auto-detected from __file__ path by default)
# CAREER_JOB_SEARCH_ROOT=/absolute/path/to/Career/job-search

# Dashboard token (also set in dashboard/.env.local)
# CAREER_DASHBOARD_TOKEN=

# Dashboard port override
# CAREER_DASHBOARD_PORT=5173

# Firecrawl API key for web research
# FIRECRAWL_API_KEY=

# Higher-precedence browser CLI override (checked before BROWSE_CLI)
# JOB_SEARCH_BROWSE_CLI=

# Chrome executable path override (checked before auto-detection)
# JOB_SEARCH_CHROME_EXECUTABLE=

# Set to 1 to disable LLM-dependent features
# JOB_SEARCH_NO_LLM=

# LinkedIn jobs browser profile directory override
# LINKEDIN_JOBS_PROFILE_DIR=

# Set to 1 to enable LLM trace logging
# RECRUITER_LLM_TRACE=

# Set to 1 to enable verbose LLM logging
# RECRUITER_LLM_VERBOSE=

# Browser executable path (auto-detected if unset; JOB_SEARCH_BROWSE_CLI takes precedence)
# BROWSE_CLI=/path/to/chrome

# MCP server token (falls back to CAREER_DASHBOARD_TOKEN if unset)
# CAREER_MCP_TOKEN=
