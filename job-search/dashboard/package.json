{
  "name": "job-search-dashboard",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true,maxRetries:5})\"",
    "build": "next build",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "20.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.2",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "postcss": "8.5.10",
    "vite": "8.0.16"
  }
}
